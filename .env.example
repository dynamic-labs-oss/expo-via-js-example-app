EXPO_PUBLIC_DYNAMIC_ENVIRONMENT_ID=your-dynamic-environment-id

# Optional: HTTPS origin used by the WaaS iframe and deep links.
# Required if you want to create embedded wallets or use passkeys.
# Update your associated domains / intent filters in app.json and dashboard too.
EXPO_PUBLIC_DYNAMIC_UNIVERSAL_LINK=https://your-app.example.com

# Optional: override the Dynamic API base URL.
# EXPO_PUBLIC_DYNAMIC_API_BASE_URL=https://app.dynamic.xyz/api/v0
